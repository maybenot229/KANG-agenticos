# Tree hygiene (PS-002): the repository holds zero runtime state.
# These patterns are ALSO lint-failures (tools/lint_tree_hygiene.py) —
# ignoring them is the second line of defence, not permission.
*.db
*.db-wal
*.db-shm
*.jsonl
!docs/**/*.jsonl
.env
# session.json (API-003): the Core's session handshake file, written to
# whatever KANG_HOME it's booted against — a live-verification run
# pointed at the repo root by mistake once, landing this at the root
# untracked and un-ignored (2026-08-05); closing the same gap the *.db
# patterns above already close for their own runtime files.
session.json

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/

# Rust build output (any src-tauri/ Cargo project, present or future —
# M6 starts a fresh Tauri project per ADR-007 §8; this pattern is
# repo-wide on purpose so its target/ is ignored wherever it lands).
**/target/

# Node (ui/ — Vite + React, ADR-011's generated client's home)
node_modules/
*.tsbuildinfo
.tsbuild-node/
ui/registry.snapshot.json
ui/src/generated/
