{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KANG",
  "version": "0.1.0",
  "identifier": "com.kang.shell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KANG",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "capture",
        "title": "KANG — Quick Capture",
        "url": "capture.html",
        "width": 560,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
