    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
